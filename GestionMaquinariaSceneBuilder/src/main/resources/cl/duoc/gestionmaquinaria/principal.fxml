               <children>
                  <TextField fx:id="txtBuscar" prefWidth="300.0" promptText="Buscar por Código..." />
                  <Button fx:id="btnAgregar" mnemonicParsing="false" onAction="#abrirRegistro" text="Agregar maquinaria" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <TableView fx:id="tablaMaquinas" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
